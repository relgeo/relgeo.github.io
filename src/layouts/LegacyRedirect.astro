---
const {
  to,
  title = 'RelGeo Redirect',
  description = 'This page has moved to the localized Indonesian route.',
} = Astro.props;

if (typeof to !== 'string' || to.length === 0) {
  throw new Error('LegacyRedirect requires a non-empty `to` path.');
}

const canonical =
  Astro.site instanceof URL ? new URL(to, Astro.site).toString() : to;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f1e5;
        --panel: #fffdf7;
        --line: #d8cfb8;
        --ink: #172033;
        --muted: #53607a;
        --accent: #0a5a69;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "IBM Plex Sans", "Segoe UI", sans-serif;
        background: linear-gradient(180deg, #fbf8f0 0%, var(--bg) 100%);
        color: var(--ink);
      }

      main {
        width: min(760px, calc(100vw - 32px));
        margin: 64px auto;
        padding: 24px;
        border: 1px solid var(--line);
        background: var(--panel);
      }

      h1 {
        margin-top: 0;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
      }

      p {
        line-height: 1.7;
        color: var(--muted);
      }

      a {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p><a href={to}>Continue to the localized route</a></p>
    </main>
  </body>
</html>
