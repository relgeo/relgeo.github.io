---
import {
  RelGeoLanguageService,
  type RelGeoSemanticLine,
} from '@relgeo/language-service';
import { buildHighlightedHtml } from '@relgeo/remark-relgeo-hl';
import type { RelGeoAnimationStepDelta, RelGeoAnimationSourceLine } from '../lib/animation-story';
import { housePlanBasicStory } from '../lib/stories/house-plan-basic';
import { renderHousePlanPreviewSvg } from '../lib/stories/house-plan-basic-preview';

type Labels = {
  title: string;
  intro: string;
  sourceTitle: string;
  previewTitle: string;
  previous: string;
  next: string;
  step: string;
  definition: string;
  manifestation: string;
  noVisual: string;
  visual: string;
};

const { labels } = Astro.props as { labels: Labels };
const languageService = new RelGeoLanguageService();
const highlightClassPrefix = 'relgeo-hl';

function sourceToHtml(
  sourceLines: RelGeoAnimationSourceLine[],
  semanticLines: RelGeoSemanticLine[],
  classPrefix: string
): string {
  return buildHighlightedHtml(
    sourceLines.map((line, index) => ({
      text: line.text,
      lineNumber: index + 1,
      blockId: line.blockId,
    })),
    semanticLines,
    classPrefix
  );
}

function getRevealBlockIds(delta: RelGeoAnimationStepDelta): string[] {
  switch (delta.op) {
    case 'add':
    case 'activate':
      return delta.blockIds;
    case 'replace-value':
      return [delta.blockId];
  }
}

const stepPayload = housePlanBasicStory.steps.map((step, index) => {
  const semanticLines = languageService.getSemanticTokens(step.sourceText);

  return {
    id: step.id,
    label: step.label,
    kind: step.kind,
    visualChange: step.visualChange,
    note: step.note ?? '',
    stepNumber: index + 1,
    stepCount: housePlanBasicStory.steps.length,
    sourceHtml: sourceToHtml(step.sourceLines, semanticLines, highlightClassPrefix),
    sourceLineCount: step.sourceLines.length,
    revealBlockIds: getRevealBlockIds(step.blockDelta),
    svg: renderHousePlanPreviewSvg(step.activeBlockIds, step.previewHighlight),
  };
});

const initialStep = stepPayload[0];
---

<section class="card home-section home-section--story">
  <p class="kicker">{labels.title}</p>
  <h2>{labels.intro}</h2>
  <div
    class="landing-story-viewer"
    data-landing-story-viewer
    data-definition-label={labels.definition}
    data-manifestation-label={labels.manifestation}
    data-visual-label={labels.visual}
    data-no-visual-label={labels.noVisual}
    data-step-word={labels.step}
    data-steps={JSON.stringify(stepPayload)}
  >
    <div class="landing-story-viewer__meta">
      <div class="landing-story-viewer__step" aria-live="polite" aria-atomic="true">
        <span data-story-step-counter>{labels.step} {initialStep.stepNumber}/{initialStep.stepCount}</span>
        <strong data-story-step-label>{initialStep.label}</strong>
      </div>
      <div class="pill-row landing-story-viewer__pills">
        <span class="pill" data-story-kind>{initialStep.kind === 'definition' ? labels.definition : labels.manifestation}</span>
        <span class="pill" data-story-visual>{initialStep.visualChange ? labels.visual : labels.noVisual}</span>
      </div>
    </div>

    <div class="artifact-grid artifact-grid--story">
      <article class="artifact-card artifact-card--source stack">
        <div class="artifact-header">
          <h3><code>rg</code> {labels.sourceTitle}</h3>
        </div>
        <div class="artifact-surface relgeo-hl relgeo-hl--rg" data-story-source set:html={initialStep.sourceHtml} />
      </article>

      <article class="artifact-card artifact-card--preview stack">
        <div class="artifact-header">
          <h3><code>relgeo</code> {labels.previewTitle}</h3>
        </div>
        <div class="artifact-surface preview-frame">
          <div class="relgeo-preview__canvas relgeo-preview__canvas--story" data-story-preview set:html={initialStep.svg} />
        </div>
      </article>
    </div>

    <div class="landing-story-viewer__footer">
      <p class="artifact-note" data-story-note>{initialStep.note}</p>
      <div class="button-row">
        <button type="button" class="button" data-story-prev>{labels.previous}</button>
        <button type="button" class="button primary" data-story-next>{labels.next}</button>
      </div>
    </div>
  </div>
</section>

<script>
  const viewers = document.querySelectorAll('[data-landing-story-viewer]');

  for (const viewer of viewers) {
    const raw = viewer.getAttribute('data-steps');
    if (!raw) continue;

    const steps = JSON.parse(raw);
    let index = 0;

    const sourceEl = viewer.querySelector('[data-story-source]');
    const previewEl = viewer.querySelector('[data-story-preview]');
    const noteEl = viewer.querySelector('[data-story-note]');
    const labelEl = viewer.querySelector('[data-story-step-label]');
    const counterEl = viewer.querySelector('[data-story-step-counter]');
    const kindEl = viewer.querySelector('[data-story-kind]');
    const visualEl = viewer.querySelector('[data-story-visual]');
    const prevBtn = viewer.querySelector('[data-story-prev]');
    const nextBtn = viewer.querySelector('[data-story-next]');

    const definitionLabel = viewer.getAttribute('data-definition-label') ?? 'Definition';
    const manifestationLabel = viewer.getAttribute('data-manifestation-label') ?? 'Manifestation';
    const visualLabel = viewer.getAttribute('data-visual-label') ?? 'Preview changes';
    const noVisualLabel = viewer.getAttribute('data-no-visual-label') ?? 'Preview unchanged';
    const stepWord = viewer.getAttribute('data-step-word') ?? 'Step';
    let highlightResetHandle = 0;
    let transitionHandle = 0;

    const renderStep = () => {
      const step = steps[index];
      const previousStep = steps[Math.max(0, index - 1)];

      if (sourceEl) sourceEl.innerHTML = step.sourceHtml;

      // A definition-only step keeps the last visual manifestation intact.
      const visualStep = [...steps]
        .slice(0, index + 1)
        .reverse()
        .find((candidate) => candidate.visualChange);
      if (previewEl && visualStep) previewEl.innerHTML = visualStep.svg;
      if (noteEl) noteEl.textContent = step.note;
      if (labelEl) labelEl.textContent = step.label;
      if (counterEl) counterEl.textContent = `${stepWord} ${step.stepNumber}/${step.stepCount}`;
      if (kindEl) kindEl.textContent = step.kind === 'definition' ? definitionLabel : manifestationLabel;
      if (visualEl) visualEl.textContent = step.visualChange ? visualLabel : noVisualLabel;
      if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = index === 0;
      if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = index === steps.length - 1;

      if (sourceEl instanceof HTMLElement) {
        const revealSelectors = [];
        for (const blockId of step.revealBlockIds) {
          revealSelectors.push(`.rg-line[data-block-id="${window.CSS.escape(blockId)}"]`);
        }

        const revealSelector = revealSelectors.join(', ');
        const revealLines = revealSelector
          ? Array.from(sourceEl.querySelectorAll(revealSelector)).filter(
              (node) => node instanceof HTMLElement
            )
          : [];
        const targetLine =
          revealLines[0] ||
          (step.sourceLineCount > (previousStep?.sourceLineCount ?? 0)
            ? sourceEl.querySelector(`.rg-line[data-line="${(previousStep?.sourceLineCount ?? 0) + 1}"]`)
            : null);

        if (highlightResetHandle) {
          window.clearTimeout(highlightResetHandle);
          highlightResetHandle = 0;
        }

        const highlightedLines = Array.from(
          sourceEl.querySelectorAll('.rg-line--reveal')
        ).filter((node) => node instanceof HTMLElement);
        for (const line of highlightedLines) {
          line.classList.remove('rg-line--reveal');
        }

        for (const line of revealLines) {
          line.classList.add('rg-line--reveal');
        }

        if (revealLines.length > 0) {
          highlightResetHandle = window.setTimeout(() => {
            for (const line of revealLines) {
              line.classList.remove('rg-line--reveal');
            }
          }, 1600);
        }

        if (targetLine instanceof HTMLElement) {
          const targetTop = Math.max(
            0,
            targetLine.offsetTop - sourceEl.clientHeight * 0.24
          );
          sourceEl.scrollTo({
            top: targetTop,
            behavior: index === 0 ? 'auto' : 'smooth',
          });
        } else {
          sourceEl.scrollTop = 0;
        }
      }
    };

    const applyStepChange = () => {
      viewer.classList.add('is-updating');

      if (transitionHandle) {
        window.clearTimeout(transitionHandle);
      }

      transitionHandle = window.setTimeout(() => {
        renderStep();
        window.requestAnimationFrame(() => {
          viewer.classList.remove('is-updating');
        });
      }, 110);
    };

    const goToPreviousStep = () => {
      const nextIndex = Math.max(0, index - 1);
      if (nextIndex === index) return;

      index = nextIndex;
      applyStepChange();
    };

    const goToNextStep = () => {
      const nextIndex = Math.min(steps.length - 1, index + 1);
      if (nextIndex === index) return;

      index = nextIndex;
      applyStepChange();
    };

    prevBtn?.addEventListener('click', () => {
      goToPreviousStep();
    });

    nextBtn?.addEventListener('click', () => {
      goToNextStep();
    });

    renderStep();
  }
</script>
