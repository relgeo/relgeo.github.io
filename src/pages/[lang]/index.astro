---
import DocsLayout from '../../layouts/DocsLayout.astro';
import LandingStoryViewer from '../../components/LandingStoryViewer.astro';
import LandingWorkflow from '../../components/LandingWorkflow.astro';
import { heroFixtureSvg } from '../../lib/hero-fixture';
import { copy, isSupportedLang, type SupportedLang } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const rawLang = Astro.params.lang;
if (!isSupportedLang(rawLang)) {
  throw new Error(`Unsupported language route: ${rawLang ?? 'unknown'}`);
}

const lang = rawLang as SupportedLang;
---

<DocsLayout
  title="RelGeo"
  eyebrow={copy({ id: 'Bahasa vektor relation-first', en: 'Relation-first vector language' }, lang)}
  lead={copy(
    {
      id: 'Tulis gambar sebagai relasi yang tetap terbaca, diselesaikan deterministik, lalu hadir sebagai artifact SVG yang berguna.',
      en: 'Write drawings as readable relations, resolve them deterministically, then make them useful as SVG artifacts.',
    },
    lang
  )}
  variant="home"
  showPageHeader={false}
  lang={lang}
  localizedSlug=""
>
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero__copy">
      <p class="landing-kicker">{copy({ id: 'RELATION-FIRST / SVG / MARKDOWN', en: 'RELATION-FIRST / SVG / MARKDOWN' }, lang)}</p>
      <h1 id="landing-title">
        {copy({ id: 'Gambar yang menjelaskan dirinya.', en: 'Drawings that explain themselves.' }, lang)}
      </h1>
      <p class="landing-hero__statement">
        {copy({ id: 'Terbaca sebelum tergambar.', en: 'Readable before it becomes form.' }, lang)}
      </p>
      <div class="landing-hero__actions">
        <a class="landing-button landing-button--primary" href={`/${lang}/docs/getting-started/`}>
          {copy({ id: 'Mulai mencoba', en: 'Start trying' }, lang)}
        </a>
        <a class="landing-button landing-button--quiet" href="#proof">
          {copy({ id: 'Lihat buktinya', en: 'See the proof' }, lang)}
        </a>
      </div>
      <p class="landing-hero__meta">
        {copy({ id: 'DSL aktif v0.5 · renderer SVG utama · jalur Markdown awal', en: 'Active DSL v0.5 · primary SVG renderer · early Markdown path' }, lang)}
      </p>
    </div>
    <svg class="landing-hero__copy-bridge" viewBox="0 0 160 100" aria-hidden="true">
      <path d="M4 58H62L102 32L156 32" />
      <circle cx="62" cy="58" r="4" />
    </svg>
    <div class="landing-hero__visual" aria-labelledby="hero-geometry-caption">
      <div class="landing-hero__visual-frame">
        <div class="landing-hero__visual-grid" aria-hidden="true"></div>
        <div class="landing-hero__visual-shape" role="img" aria-label={copy({ id: 'Preview fixture RelGeo yang dirender sebagai SVG', en: 'Rendered SVG preview of the RelGeo fixture' }, lang)}>
          <span class="landing-anchor landing-anchor--one"></span>
          <span class="landing-anchor landing-anchor--two"></span>
          <span class="landing-anchor landing-anchor--three"></span>
          <span class="landing-dimension landing-dimension--x">relation / center</span>
          <span class="landing-dimension landing-dimension--y">anchor / intent</span>
          <div class="landing-hero__rendered-art" set:html={heroFixtureSvg} />
          <svg class="landing-hero__relation-overlay" viewBox="0 0 440 300" aria-hidden="true">
            <path d="M32 150H112M328 150H408M112 150L220 94M328 150L220 94" />
            <circle cx="220" cy="94" r="5" />
            <path d="M112 150V198M328 150V198M112 198H328" />
          </svg>
        </div>
        <p class="landing-hero__caption">fixture / resolve / SVG</p>
      </div>
    </div>
  </section>

  <LandingWorkflow
    labels={{
      sourceLabel: 'rg',
      previewLabel: 'relgeo',
      steps: ['EDIT', 'RESOLVE', 'PREVIEW', 'INSPECT'],
      sourceDescription: copy({ id: 'Terbaca sebelum tergambar.', en: 'Readable before it becomes form.' }, lang),
      previewDescription: copy({ id: 'Artifact render untuk dipakai, bukan source kedua.', en: 'A render artifact to use, not a second source.' }, lang),
      relationLabel: copy({ id: 'relasi menjadi bentuk', en: 'relations become form' }, lang),
    }}
  />

  <section class="landing-proof-row" id="proof" aria-labelledby="proof-title">
    <h2 id="proof-title" class="sr-only">{copy({ id: 'Bukti RelGeo', en: 'RelGeo proof' }, lang)}</h2>
    <article>
      <span class="landing-proof-index">01</span>
      <h3>{copy({ id: 'Readable source', en: 'Readable source' }, lang)}</h3>
      <p>{copy({ id: 'Intent tetap hadir di teks, review, dan diff.', en: 'Intent stays present in text, review, and diffs.' }, lang)}</p>
    </article>
    <article>
      <span class="landing-proof-index">02</span>
      <h3>{copy({ id: 'Deterministic geometry', en: 'Deterministic geometry' }, lang)}</h3>
      <p>{copy({ id: 'Input yang sama menghasilkan scene yang stabil.', en: 'The same input produces a stable scene.' }, lang)}</p>
    </article>
    <article>
      <span class="landing-proof-index">03</span>
      <h3>{copy({ id: 'Markdown path', en: 'Markdown path' }, lang)}</h3>
      <p>{copy({ id: '`rg` untuk source; `relgeo` untuk preview.', en: '`rg` for source; `relgeo` for preview.' }, lang)}</p>
    </article>
  </section>

  <section class="landing-technical-proof" aria-labelledby="technical-proof-title">
    <div>
      <p class="landing-kicker">{copy({ id: 'UJIAN KERAS PERTAMA', en: 'FIRST HARD TEST' }, lang)}</p>
      <h2 id="technical-proof-title">{copy({ id: 'Technical drawing bukti ketelitian—bukan batasan.', en: 'Technical drawing proves the rigor—it does not define the whole identity.' }, lang)}</h2>
      <p>{copy({ id: 'RelGeo mulai dari domain yang menuntut presisi, determinisme, dan intent yang jelas. Bahasa ini dirancang untuk tumbuh lebih luas dari satu gambar atau satu domain.', en: 'RelGeo starts where precision, determinism, and clear intent are non-negotiable. The language is designed to grow beyond one drawing or one domain.' }, lang)}</p>
    </div>
    <div class="landing-technical-proof__artifact">
      <LandingStoryViewer
        labels={{
          title: copy({ id: 'Fixture tervalidasi', en: 'Verified fixture' }, lang),
          intro: copy({ id: 'Satu denah tumbuh dari source ke preview.', en: 'One plan grows from source to preview.' }, lang),
          sourceTitle: copy({ id: 'source', en: 'source' }, lang),
          previewTitle: copy({ id: 'preview', en: 'preview' }, lang),
          previous: copy({ id: 'Sebelumnya', en: 'Previous' }, lang),
          next: copy({ id: 'Berikutnya', en: 'Next' }, lang),
          step: copy({ id: 'Langkah', en: 'Step' }, lang),
          definition: copy({ id: 'Definisi', en: 'Definition' }, lang),
          manifestation: copy({ id: 'Manifestasi', en: 'Manifestation' }, lang),
          noVisual: copy({ id: 'Preview tetap', en: 'Preview unchanged' }, lang),
          visual: copy({ id: 'Preview berubah', en: 'Preview changes' }, lang),
        }}
      />
    </div>
  </section>

  <section class="landing-cta-band" aria-labelledby="landing-cta-title">
    <div>
      <p class="landing-kicker">ACTIVE V0.5</p>
      <h2 id="landing-cta-title">{copy({ id: 'Dari source, lihat hasilnya', en: 'Start from source. Inspect the result.' }, lang)}</h2>
    </div>
    <nav class="landing-cta-links" aria-label={copy({ id: 'Jalur aktif', en: 'Active paths' }, lang)}>
      <a href={`/${lang}/docs/getting-started/`}>{copy({ id: 'Getting started', en: 'Getting started' }, lang)}</a>
      <a href={`/${lang}/current-capabilities/`}>{copy({ id: 'Current capabilities', en: 'Current capabilities' }, lang)}</a>
      <a href={`/${lang}/docs/language-spec/`}>{copy({ id: 'Language spec', en: 'Language spec' }, lang)}</a>
    </nav>
  </section>
</DocsLayout>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .shell--home {
    --paper: #f4ebdd;
    --paper-deep: #e8ddc8;
    --ink-blue: #162033;
    --teal: #0f6370;
    --coral: #f05a47;
    --signal: #c7f000;
    width: min(1280px, calc(100vw - 32px));
  }

  .shell--home .topbar {
    border: 0;
    border-bottom: 1px solid rgba(184, 169, 139, 0.72);
    border-radius: 0;
    background: rgba(250, 245, 232, 0.98);
    box-shadow: 0 10px 28px rgba(23, 32, 51, 0.08);
    backdrop-filter: blur(12px);
    padding: 14px 0 12px;
  }

  .shell--home .brand {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .shell--home .nav a,
  .shell--home .lang-switcher a {
    border-radius: 0;
    color: var(--ink-blue);
  }

  .landing-hero {
    position: relative;
    display: grid;
    gap: 36px;
    align-items: center;
    min-height: min(720px, calc(100vh - 120px));
    padding: 62px clamp(8px, 4vw, 58px) 76px;
  }

  .landing-hero__copy {
    max-width: 660px;
  }

  .landing-kicker {
    margin: 0 0 14px;
    color: var(--teal);
    font: 700 0.72rem/1.2 'IBM Plex Mono', monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .landing-hero h1,
  .landing-workflow h2,
  .landing-technical-proof h2,
  .landing-cta-band h2 {
    margin: 0;
    color: var(--ink-blue);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .landing-hero h1 {
    max-width: 10ch;
    font-size: clamp(3.6rem, 6vw, 5rem);
    line-height: 0.88;
  }

  .landing-hero__statement {
    max-width: 46ch;
    margin: 28px 0 0;
    color: #354258;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.55;
  }

  .landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .landing-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 18px;
    border: 1px solid var(--ink-blue);
    border-radius: 0;
    color: var(--ink-blue);
    font: 700 0.9rem/1 'IBM Plex Sans', sans-serif;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .landing-button:hover,
  .landing-button:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--coral);
    outline-offset: 3px;
  }

  .landing-button--primary {
    border-color: var(--coral);
    background: var(--coral);
    color: #fff8f0;
  }

  .landing-button--quiet {
    border-color: rgba(22, 32, 51, 0.42);
    background: transparent;
  }

  .landing-hero__meta {
    margin: 22px 0 0;
    color: #586479;
    font: 0.76rem/1.5 'IBM Plex Mono', monospace;
  }

  .landing-hero__copy-bridge {
    position: absolute;
    top: 47%;
    left: 38%;
    z-index: 2;
    width: 17%;
    height: 18%;
    overflow: visible;
    fill: none;
    stroke: var(--coral);
    stroke-width: 1.4;
    stroke-dasharray: 5 5;
    opacity: 0.9;
  }

  .landing-hero__copy-bridge circle { fill: var(--paper); stroke: var(--coral); stroke-width: 1.5; }

  .landing-hero__visual-frame {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    border: 0;
    background: transparent;
  }

  .landing-hero__visual-grid {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background: repeating-linear-gradient(0deg, transparent 0 31px, rgba(22, 32, 51, 0.1) 32px), repeating-linear-gradient(90deg, transparent 0 31px, rgba(22, 32, 51, 0.1) 32px);
  }

  .landing-hero__visual-shape {
    position: absolute;
    inset: 0% 0% 16%;
    display: grid;
    place-items: center;
  }

  .landing-hero__rendered-art {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .landing-hero__rendered-art svg { display: block; width: 100%; height: auto; }

  .landing-hero__relation-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--coral);
    stroke-width: 1.2;
    stroke-dasharray: 5 6;
    opacity: 0.82;
  }

  .landing-hero__relation-overlay circle { fill: var(--signal); stroke: var(--ink-blue); stroke-width: 1.5; }

  .landing-hero-line {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .landing-hero-line--construction {
    stroke: rgba(22, 32, 51, 0.4);
    stroke-width: 1;
    stroke-dasharray: 5 6;
  }

  .landing-hero-line--relation {
    stroke: var(--coral);
    stroke-width: 2;
  }

  .landing-hero-line--measure {
    stroke: var(--teal);
    stroke-width: 1.5;
  }

  .landing-hero-form {
    fill: rgba(255, 248, 238, 0.42);
    stroke: var(--ink-blue);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .landing-hero-point {
    fill: var(--signal);
    stroke: var(--ink-blue);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .landing-anchor {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 2px solid var(--coral);
    background: var(--signal);
    transform: rotate(45deg);
    z-index: 2;
  }

  .landing-anchor--one { top: 8%; left: 50%; }
  .landing-anchor--two { top: 27%; left: 16%; }
  .landing-anchor--three { top: 27%; right: 16%; }

  .landing-dimension {
    position: absolute;
    z-index: 2;
    color: var(--teal);
    font: 0.66rem/1 'IBM Plex Mono', monospace;
    text-transform: uppercase;
  }

  .landing-dimension--x { right: 4%; bottom: 10%; }
  .landing-dimension--y { top: 44%; left: 2%; transform: rotate(-90deg); }

  .landing-hero__caption {
    position: absolute;
    right: 18px;
    bottom: 14px;
    z-index: 3;
    margin: 0;
    padding-left: 8px;
    background: rgba(232, 221, 200, 0.84);
    color: var(--ink-blue);
    font: 0.7rem/1 'IBM Plex Mono', monospace;
    text-transform: uppercase;
  }

  .landing-workflow {
    padding: 42px 0 18px;
  }

  .landing-workflow__intro {
    display: grid;
    grid-template-columns: minmax(180px, 0.5fr) 1fr;
    gap: 24px;
    align-items: end;
    margin: 0 clamp(8px, 4vw, 58px) 20px;
  }

  .landing-workflow h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
  }

  .landing-workflow__grid {
    display: grid;
    gap: 14px;
  }

  .landing-source-panel,
  .landing-preview-panel {
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--ink-blue);
  }

  .landing-source-panel { display: flex; flex-direction: column; }

  .landing-source-panel { background: var(--ink-blue); color: #f4ebdd; }
  .landing-preview-panel { background: #dcedef; color: var(--ink-blue); }

  .landing-panel-heading {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: 54px;
  }

  .landing-panel-heading p:last-child {
    margin: 3px 0 0;
    color: inherit;
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .landing-panel-index {
    color: var(--coral);
    font: 0.72rem/1 'IBM Plex Mono', monospace;
  }

  .landing-source-panel .landing-kicker { color: var(--signal); }
  .landing-source-code.relgeo-hl {
    min-height: 0;
    flex: 1 1 auto;
    max-height: 360px;
    margin-top: 18px;
    overflow: auto;
    border: 1px solid rgba(199, 240, 0, 0.28);
    border-radius: 0;
    background: #202b3d;
    box-shadow: none;
    scrollbar-color: rgba(199, 240, 0, 0.72) rgba(32, 43, 61, 0.9);
    scrollbar-width: thin;
  }

  .landing-source-code.relgeo-hl:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .landing-source-code.relgeo-hl::before { background: rgba(199, 240, 0, 0.18); }
  .landing-source-code .relgeo-hl__code { color: #f4ebdd; }
  .landing-source-code .rg-line::before { color: rgba(244, 235, 221, 0.5); }

  .landing-workflow-rail {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }

  .landing-workflow-rail li {
    display: grid;
    gap: 4px;
    color: #586479;
    font: 0.68rem/1.15 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
  }

  .landing-workflow-rail li::after { content: '→'; color: var(--coral); }
  .landing-workflow-rail li:last-child::after { content: ''; }
  .landing-workflow-rail li.is-active { color: var(--ink-blue); }
  .landing-workflow-rail li span { color: var(--coral); }

  .landing-preview-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 360px;
    margin-top: 18px;
    overflow: hidden;
    border: 1px solid rgba(15, 99, 112, 0.35);
    background: #f7fbfa;
  }

  .landing-preview-panel { display: flex; flex-direction: column; }

  .landing-preview-art { position: relative; z-index: 1; width: 78%; }
  .landing-preview-art svg { display: block; width: 100%; height: auto; }
  .landing-relation-overlay { position: absolute; inset: 12% 6%; width: 88%; height: 76%; fill: none; stroke: rgba(240, 90, 71, 0.68); stroke-width: 0.8; stroke-dasharray: 3 3; }
  .landing-relation-overlay circle { fill: var(--signal); stroke: var(--ink-blue); stroke-width: 1; }
  .landing-relation-overlay text { fill: var(--teal); stroke: none; font: 4px 'IBM Plex Mono', monospace; }
  .landing-artifact-caption { margin: 12px 0 0; color: var(--teal); font: 0.7rem/1 'IBM Plex Mono', monospace; text-transform: uppercase; }

  .landing-proof-row {
    display: grid;
    gap: 24px;
    padding: 68px clamp(8px, 4vw, 58px);
    border-top: 1px solid #b8a98b;
    border-bottom: 1px solid #b8a98b;
  }

  .landing-proof-row article { border-left: 2px solid var(--coral); padding-left: 16px; }
  .landing-proof-index { color: var(--coral); font: 0.72rem/1 'IBM Plex Mono', monospace; }
  .landing-proof-row h3 { margin: 12px 0 8px; font: 600 1.3rem/1.1 Georgia, 'Times New Roman', serif; }
  .landing-proof-row p { margin: 0; color: #586479; font-size: 0.92rem; line-height: 1.5; }

  .landing-technical-proof {
    display: grid;
    gap: 30px;
    align-items: start;
    padding: 72px clamp(8px, 4vw, 58px);
  }

  .landing-technical-proof > div:first-child { max-width: 540px; }
  .landing-technical-proof h2 { font-size: clamp(2.3rem, 5vw, 4.6rem); line-height: 0.94; }
  .landing-technical-proof > div:first-child > p:last-child { margin-top: 24px; color: #586479; line-height: 1.65; }
  .landing-technical-proof__artifact .home-section--story { padding: 20px; border-radius: 0; box-shadow: none; }
  .landing-technical-proof__artifact .home-section--story > .kicker,
  .landing-technical-proof__artifact .home-section--story > h2 { display: none; }
  .landing-technical-proof__artifact .landing-story-viewer__meta { margin-bottom: 12px; }

  .landing-cta-band {
    display: grid;
    gap: 24px;
    align-items: center;
    padding: 42px clamp(20px, 5vw, 68px);
    background: var(--ink-blue);
    color: #f4ebdd;
  }

  .landing-cta-band h2 { max-width: 13ch; color: #f4ebdd; font-size: clamp(2.5rem, 5vw, 5rem); line-height: 0.9; }
  .landing-cta-band .landing-kicker { color: var(--signal); }
  .landing-cta-links { display: flex; flex-wrap: wrap; gap: 12px 22px; }
  .landing-cta-links a { color: #f4ebdd; font: 700 0.88rem/1.3 'IBM Plex Mono', monospace; text-underline-offset: 5px; }
  .landing-cta-links a:hover, .landing-cta-links a:focus-visible { color: var(--signal); }

  @media (min-width: 900px) {
    .landing-hero { grid-template-columns: minmax(0, 0.88fr) minmax(440px, 1.12fr); }
    .landing-workflow__grid { grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr); align-items: start; }
    .landing-source-panel,
    .landing-preview-panel { height: 500px; }
    .landing-source-code.relgeo-hl,
    .landing-preview-stage { min-height: 0; }
    .landing-preview-stage { flex: 1 1 auto; }
    .landing-workflow-rail { display: grid; align-content: center; gap: 20px; padding: 20px 0; }
    .landing-workflow-rail li { grid-template-columns: 28px 1fr; align-items: center; }
    .landing-workflow-rail li::after { grid-column: 2; content: '↓'; }
    .landing-workflow-rail li:last-child::after { content: ''; }
    .landing-proof-row { grid-template-columns: repeat(3, 1fr); }
    .landing-technical-proof { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); }
    .landing-cta-band { grid-template-columns: minmax(0, 1fr) auto; }
  }

  @media (max-width: 899px) {
    .landing-workflow__intro { grid-template-columns: 1fr; }
    .landing-hero__copy-bridge { display: none; }
  }

  @media (min-width: 900px) and (max-height: 780px) {
    .landing-hero {
      min-height: 480px;
      padding-top: 28px;
      padding-bottom: 32px;
    }

    .landing-hero__visual-frame { min-height: 370px; }
    .landing-workflow { padding-top: 28px; }
    .landing-workflow__intro { margin-bottom: 10px; }
    .landing-workflow h2 { font-size: clamp(1.8rem, 3.2vw, 2.8rem); }
  }

  @media (min-width: 1200px) and (min-height: 781px) {
    .landing-hero {
      min-height: 600px;
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .landing-workflow { padding-top: 32px; }
  }

  @media (max-width: 640px) {
