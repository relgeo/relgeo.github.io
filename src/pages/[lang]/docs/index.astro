---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import {
  entryTitle,
  languageSpecSection,
  normalizeEntryId,
  localizedLanguageSpecHref,
} from '../../../lib/content';
import { copy, isSupportedLang, uiCopy, type SupportedLang } from '../../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const rawLang = Astro.params.lang;
if (!isSupportedLang(rawLang)) {
  throw new Error(`Unsupported language route: ${rawLang ?? 'unknown'}`);
}

const lang = rawLang as SupportedLang;
const specEntries = await getCollection('languageSpec');
const rootSpec = specEntries.find((entry) => normalizeEntryId(entry.id) === '');
const sectionEntries = specEntries
  .filter((entry) => normalizeEntryId(entry.id).split('/').length === 1 && normalizeEntryId(entry.id) !== '')
  .sort((a, b) => localizedLanguageSpecHref(a, lang).localeCompare(localizedLanguageSpecHref(b, lang)));

const docsNavItems = [
  {
    href: `/${lang}/docs/getting-started/`,
    title: 'Getting Started',
    description: copy(
      {
        id: 'Jalur baca tercepat untuk memahami bentuk dasar dan cara membaca RelGeo.',
        en: 'The fastest reading path to understand RelGeo’s shape and how to read it.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/current-capabilities/`,
    title: 'Current Capabilities',
    description: copy(
      {
        id: 'Ringkasan jujur tentang kapabilitas yang sudah siap dilihat dan dicoba hari ini.',
        en: 'An honest summary of the capabilities that are already ready to be seen and tried today.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/markdown-surfaces/`,
    title: 'Markdown Surfaces',
    description: copy(
      {
        id: 'Pahami dua fence publik: `rg` untuk source dan `relgeo` untuk preview atau embed.',
        en: 'Understand the two public fences: `rg` for source and `relgeo` for preview or embed.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/cli/`,
    title: 'CLI',
    description: copy(
      {
        id: 'Surface terminal untuk validasi, compile, dan workflow shell atau CI ringan.',
        en: 'The terminal surface for validation, compilation, and lightweight shell or CI workflows.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/playground/`,
    title: 'Playground',
    description: copy(
      {
        id: 'IDE browser ringan untuk authoring, preview, dan inspection cepat.',
        en: 'The lightweight browser IDE for quick authoring, preview, and inspection.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/desktop-app/`,
    title: 'Desktop App',
    description: copy(
      {
        id: 'Workbench lokal yang lebih kaya daripada playground browser.',
        en: 'The richer local workbench beyond the browser playground.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/docs/language-status/`,
    title: 'Language Status',
    description: copy(
      {
        id: 'Pahami boundary antara rumah normatif aktif, surface Inggris, dan route publik.',
        en: 'Understand the boundary between the active normative home, the English surface, and the public routes.',
      },
      lang
    ),
  },
  {
    href: `/${lang}/why-relgeo/`,
    title: 'Why RelGeo',
    description: copy(
      {
        id: 'Masalah yang ingin dijawab dan posisi produk RelGeo hari ini.',
        en: 'The problem RelGeo is trying to solve and its current product position.',
      },
      lang
    ),
  },
  {
    href: rootSpec ? localizedLanguageSpecHref(rootSpec, lang) : `/${lang}/docs/language-spec/`,
    title: 'Language Spec',
    description: copy(
      {
        id: 'Kontrak bahasa aktif yang dirender dari source normatif.',
        en: 'The active language contract rendered from the normative source.',
      },
      lang
    ),
  },
];

const docsOrientationItems = docsNavItems.filter((item) => ['Getting Started', 'Current Capabilities', 'Markdown Surfaces', 'Language Status'].includes(item.title));
const docsSurfaceItems = docsNavItems.filter((item) => ['CLI', 'Playground', 'Desktop App'].includes(item.title));

const docsGroups = [
  {
    id: 'orientation',
    title: copy({ id: 'Orientasi', en: 'Orientation' }, lang),
    description: copy(
      {
        id: 'Mulai dari halaman yang menjelaskan cara membaca RelGeo dan boundary publiknya.',
        en: 'Start with the pages that explain how to read RelGeo and its public boundary.',
      },
      lang
    ),
    items: docsOrientationItems,
  },
  {
    id: 'surfaces',
    title: copy({ id: 'Surface penggunaan', en: 'Usage surfaces' }, lang),
    description: copy(
      {
        id: 'Pilih surface kerja yang paling dekat dengan kebutuhan Anda.',
        en: 'Choose the working surface closest to your need.',
      },
      lang
    ),
    items: docsSurfaceItems,
  },
  {
    id: 'language-spec',
    title: copy({ id: 'Kontrak bahasa', en: 'Language contract' }, lang),
    description: copy(
      {
        id: 'Buka language spec saat Anda membutuhkan aturan final yang diikuti implementasi.',
        en: 'Open the language spec when you need the final rules followed by the implementation.',
      },
      lang
    ),
    items: sectionEntries.map((entry) => ({
      href: localizedLanguageSpecHref(entry, lang),
      title: entryTitle(entry, languageSpecSection(entry)),
      description: copy({ id: 'Section dari source normatif aktif.', en: 'A section from the active normative source.' }, lang),
    })),
  },
];
---

<DocsLayout
  title={copy({ id: 'Documentation', en: 'Documentation' }, lang)}
  eyebrow={copy({ id: 'Website RelGeo', en: 'RelGeo Website' }, lang)}
  lead={copy(
    {
      id: 'Documentation memuat guide penggunaan surface RelGeo. Language spec tetap menjadi rumah kontrak aktif.',
      en: 'Documentation contains usage guides for RelGeo surfaces. The language spec remains the home of the active contract.',
    },
    lang
  )}
  variant="docs"
  lang={lang}
  localizedSlug="docs"
>
  <div class="docs-shell docs-shell--index">
    <aside class="docs-sidebar docs-sidebar--index">
      <p class="kicker">{copy({ id: 'Peta docs', en: 'Docs map' }, lang)}</p>
      <h2>{copy({ id: 'Documentation', en: 'Documentation' }, lang)}</h2>
      <p class="spec-section-note">
        {copy(
          {
            id: 'Pilih satu jalur baca. Daftar utama di kanan memuat semua route penting.',
            en: 'Choose a reading path. The main index contains every important route.',
          },
          lang
        )}
      </p>
      <nav class="docs-index-nav" aria-label={copy({ id: 'Kelompok dokumentasi', en: 'Documentation groups' }, lang)}>
        {docsGroups.map((group, index) => (
          <a href={`#${group.id}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{group.title}</strong>
          </a>
        ))}
      </nav>
      <a class="docs-sidebar-utility" href={`/${lang}/why-relgeo/`}>
        {copy({ id: 'Baca mengapa RelGeo', en: 'Read why RelGeo' }, lang)}
      </a>
    </aside>

    <div class="docs-index-column">
      <section class="docs-index-hero">
        <div class="hero-grid">
          <div>
            <p class="kicker">{copy({ id: 'Documentation Layer', en: 'Documentation Layer' }, lang)}</p>
            <h2>{copy({ id: 'Mulai dari docs. Pindah ke spec saat Anda membutuhkan kontrak aktif.', en: 'Start with docs. Move to the spec when you need the active contract.' }, lang)}</h2>
            <p>
              {copy(
                {
                  id: 'Guide penggunaan berada di documentation. Aturan final bahasa tetap berada di language spec.',
                  en: 'Usage guides live in documentation. The final language rules stay in the language spec.',
                },
                lang
              )}
            </p>
            <p>
              {copy(
                {
                  id: 'Mulai dari halaman pengantar, pilih surface penggunaan yang paling dekat dengan kebutuhan Anda, lalu buka language spec saat perlu melihat aturan final yang diikuti implementasi.',
                  en: 'Start from the orientation pages, choose the usage surface closest to your need, then open the language spec when you need the final rules followed by the implementation.',
                },
                lang
              )}
            </p>
            <p class="docs-index-actions"><a href={`/${lang}/docs/getting-started/`}>{copy(uiCopy.openGettingStarted, lang)}</a><a href={`/${lang}/docs/language-spec/`}>{copy(uiCopy.openLanguageSpec, lang)}</a></p>
          </div>
          <aside class="docs-reading-path">
            <h2>{copy({ id: 'Read in this order', en: 'Read in this order' }, lang)}</h2>
            <ol class="meta-list">
              <li><a href={`/${lang}/docs/getting-started/`}>{copy(uiCopy.gettingStarted, lang)}</a></li>
              <li><a href={`/${lang}/docs/current-capabilities/`}>{copy(uiCopy.currentCapabilities, lang)}</a></li>
              <li><a href={`/${lang}/docs/cli/`}>{copy(uiCopy.cliOrPlayground, lang)}</a></li>
              <li><a href={`/${lang}/docs/markdown-surfaces/`}>{copy(uiCopy.markdownSurfaces, lang)}</a></li>
              <li><a href={`/${lang}/docs/language-spec/`}>{copy(uiCopy.activeLanguageSpecLower, lang)}</a></li>
            </ol>
          </aside>
        </div>
      </section>

      {docsGroups.map((group) => (
        <section id={group.id} class="docs-index-group">
          <header>
            <p class="kicker">{group.title}</p>
            <h2>{group.title}</h2>
            <p>{group.description}</p>
          </header>
          <div class="docs-link-list">
            {group.items.map((item, index) => (
              <a class="docs-link-row" href={item.href}>
                <span class="docs-link-index">{String(index + 1).padStart(2, '0')}</span>
                <span><strong>{item.title}</strong><small>{item.description}</small></span>
                <span class="docs-link-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</DocsLayout>
