---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { entryLang, entryTitle, stripLangPrefix, localizedDocsHref } from '../../../lib/content';
import { copy, isSupportedLang, uiCopy, type SupportedLang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('docsPages');
  return entries
    .filter((entry) => {
      const lang = entryLang(entry.id);
      return lang && stripLangPrefix(entry.id, lang) !== '';
    })
    .map((entry) => {
      const lang = entryLang(entry.id) as SupportedLang;
      return {
        params: { lang, slug: stripLangPrefix(entry.id, lang) },
        props: { entry },
      };
    });
}

const rawLang = Astro.params.lang;
if (!isSupportedLang(rawLang)) {
  throw new Error(`Unsupported language route: ${rawLang ?? 'unknown'}`);
}

const lang = rawLang as SupportedLang;
const { entry } = Astro.props;
const { Content } = await render(entry);
const docsEntries = (await getCollection('docsPages'))
  .filter((candidate) => entryLang(candidate.id) === lang && stripLangPrefix(candidate.id, lang) !== '')
  .sort((a, b) => localizedDocsHref(a, lang).localeCompare(localizedDocsHref(b, lang)));
const normalized = stripLangPrefix(entry.id, lang);
const currentIndex = docsEntries.findIndex((candidate) => stripLangPrefix(candidate.id, lang) === normalized);
const nextDocsEntry = currentIndex >= 0 && currentIndex < docsEntries.length - 1 ? docsEntries[currentIndex + 1] ?? null : null;
const docsIndex = docsEntries.map((candidate) => ({
  href: localizedDocsHref(candidate, lang),
  title: entryTitle(candidate, 'Docs Page'),
  description: candidate.data.description ?? copy({ id: 'Guide non-normatif yang dimiliki oleh website ini.', en: 'A non-normative guide owned by this website.' }, lang),
}));
---

<DocsLayout
  title={entryTitle(entry, 'Documentation')}
  eyebrow={copy({ id: 'RelGeo Docs', en: 'RelGeo Docs' }, lang)}
  lead={copy(
    {
      id: 'Documentation non-normatif yang dimiliki oleh website resmi RelGeo.',
      en: 'Non-normative documentation owned by the official RelGeo website.',
    },
    lang
  )}
  variant="docs"
  lang={lang}
  localizedSlug={`docs/${normalized}`}
>
  <div class="docs-shell docs-shell--leaf">
    <aside class="docs-sidebar docs-sidebar--leaf">
      <h2>{copy(uiCopy.docsNavigation, lang)}</h2>
      <p class="spec-section-note">
        {copy(
          {
            id: 'Halaman ini berada di layer documentation non-normatif. Gunakan sidebar untuk berpindah cepat tanpa kehilangan urutan baca.',
            en: 'This page belongs to the non-normative documentation layer. Use the sidebar to move quickly without losing the reading order.',
          },
          lang
        )}
      </p>
      <p><a href={`/${lang}/docs/`}>{copy(uiCopy.backToDocsIndex, lang)}</a></p>
      <section class="stack">
        <h3>{copy(uiCopy.pages, lang)}</h3>
        <nav class="docs-sidebar-nav" aria-label="Docs pages">
          {docsIndex.map((item) => (
            <a class="docs-sidebar-link" href={item.href} aria-current={item.href === localizedDocsHref(entry, lang) ? 'page' : undefined}>
              <strong>{item.title}</strong>
              <span>{item.description}</span>
            </a>
          ))}
        </nav>
      </section>
      <section class="stack">
        <h3>{copy(uiCopy.related, lang)}</h3>
        <ul>
          <li><a href={`/${lang}/why-relgeo/`}>{copy({ id: 'Mengapa RelGeo', en: 'Why RelGeo' }, lang)}</a></li>
          <li><a href={`/${lang}/docs/language-spec/`}>{copy(uiCopy.activeLanguageSpec, lang)}</a></li>
        </ul>
      </section>
    </aside>

    <div class="docs-leaf-column">
      <article class="article docs-reading--leaf">
        <Content />
      </article>

      <section class="docs-next docs-next--leaf">
        <article class="docs-context-card">
          <p class="kicker">{copy(uiCopy.related, lang)}</p>
          <h3><a href={`/${lang}/why-relgeo/`}>{copy({ id: 'Mengapa RelGeo', en: 'Why RelGeo' }, lang)}</a></h3>
          <p>{copy({ id: 'Gunakan ini bila Anda ingin membaca problem framing dan product intent terlebih dahulu.', en: 'Use this when you want to read the problem framing and product intent first.' }, lang)}</p>
        </article>
        <article class="docs-context-card">
          <p class="kicker">{copy(uiCopy.nextReading, lang)}</p>
          <h3>
            <a href={nextDocsEntry ? localizedDocsHref(nextDocsEntry, lang) : `/${lang}/docs/language-spec/`}>
              {nextDocsEntry ? entryTitle(nextDocsEntry, 'Next Docs Page') : copy(uiCopy.openLanguageSpec, lang)}
            </a>
          </h3>
          <p>
            {nextDocsEntry
              ? copy({ id: 'Lanjutkan ke guide berikutnya di layer documentation.', en: 'Continue to the next guide in the documentation layer.' }, lang)
              : copy({ id: 'Jika pengantar ini sudah cukup, lanjutkan ke kontrak normatif aktif.', en: 'If this introduction is enough, continue to the active normative contract.' }, lang)}
          </p>
        </article>
      </section>
    </div>
  </div>
</DocsLayout>
